<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- ── Identity ─────────────────────────────────────────────────────── -->
    <key>CFBundleName</key>
    <string>Curie</string>

    <key>CFBundleDisplayName</key>
    <string>Curie</string>

    <key>CFBundleIdentifier</key>
    <string>com.curie.app</string>

    <!-- CFBundleVersion:          monotonically increasing integer (used by Sparkle) -->
    <!-- CFBundleShortVersionString: human-readable "1.0.0"                           -->
    <key>CFBundleVersion</key>
    <string>1</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- ── macOS specific ───────────────────────────────────────────────── -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <key>NSHighResolutionCapable</key>
    <true/>

    <key>LSUIElement</key>
    <false/>

    <!-- ── Permissions ──────────────────────────────────────────────────── -->
    <!-- Required: open local web server URL in WKWebView -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- User-visible reason strings (macOS Sonoma+ privacy prompts) -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>Curie indexes your notes vault to power AI-assisted search.</string>

    <key>NSDocumentsFolderUsageDescription</key>
    <string>Curie indexes your notes vault to power AI-assisted search.</string>

    <key>NSDownloadsFolderUsageDescription</key>
    <string>Curie may read files from Downloads when you add them as context.</string>

    <!-- ── Sparkle auto-update ──────────────────────────────────────────── -->
    <!--
        Replace SUFeedURL with the raw GitHub URL to your appcast.xml.
        Replace SUPublicEDKey with the output of `generate_keys` from Sparkle.
    -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/YOUR_ORG/curie/main/macos/appcast.xml</string>

    <key>SUPublicEDKey</key>
    <string>REPLACE_WITH_YOUR_SPARKLE_ED25519_PUBLIC_KEY</string>

    <key>SUEnableAutomaticChecks</key>
    <true/>

</dict>
</plist>
